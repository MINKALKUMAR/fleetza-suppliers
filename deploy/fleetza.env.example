# Copy to /etc/fleetza/supplier.env on your Hostinger VPS (chown root:root /etc/fleetza/supplier.env && chmod 600 /etc/fleetza/supplier.env)
# Binds strictly to localhost port 8081 so traffic flows only via Nginx HTTPS and never collides with fuel.fleetza.in on 8080.

SERVER_ADDRESS=127.0.0.1
PORT=8081
SPRING_PROFILES_ACTIVE=mysql
DB_ALLOW_H2_FALLBACK=false
SEED_DEMO_DATA=false
ALLOW_DEMO_AUTH_ALIASES=false

# MySQL Database (Create DB: CREATE DATABASE fleetza_suppliers CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DB_URL=jdbc:mysql://127.0.0.1:3306/fleetza_suppliers?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&createDatabaseIfNotExist=true&characterEncoding=UTF-8
DB_USERNAME=fleetza_supplier
DB_PASSWORD=REPLACE_WITH_STRONG_MYSQL_PASSWORD

# Optional: Initial password for default 'admin' account on first boot (change in UI after logging in)
ADMIN_INITIAL_PASSWORD=Admin@12345

# Minimum 64-char random hex JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_SECRET
JWT_EXPIRATION_MS=2592000000

# Allowed Frontend Origins
CORS_ALLOWED_ORIGINS=https://supplier.fleetza.in,https://www.supplier.fleetza.in

# Zero-Cost Web Push (VAPID) Keys - generate once with: node deploy/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@fleetza.in

